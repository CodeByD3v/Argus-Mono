# ==========================================
# Argus-Mono Monorepo .gitignore
# ==========================================

# Node / Frontend Dependencies & Builds
node_modules/
*/node_modules/
frontend/node_modules/
dist/
frontend/dist/
*.local

# Python Byte-compiled & Caches
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Large Reconstruction Pipeline Outputs (temporary artifacts)
outputs/
backend/outputs/
backend/Dataset/missions/mission_*/drone_flight*.mp4
scratch/
backend/scratch/
Dataset/**/*.bag
*.bag

# OS & Editor Settings
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.orig

# Environment & Secrets
.env
.env.*
!.env.example
